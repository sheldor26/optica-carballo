# ============================================
# Óptica Carballo - Variables de entorno
# ============================================
# Copiar este archivo como .env.local y llenar con valores reales.
# NUNCA commitear .env.local — sólo este .env.example.

# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Mercado Pago
# ============================================
# TEST tokens para desarrollo, PROD para producción
MP_ACCESS_TOKEN=TEST-XXXX-XXXX-XXXX
MP_PUBLIC_KEY=TEST-XXXX-XXXX-XXXX
MP_WEBHOOK_SECRET=your-webhook-secret
MP_NOTIFICATION_URL=https://opticacarballo.com.ar/api/mp/webhook

# ============================================
# LLM Provider (para features de IA)
# ============================================
ANTHROPIC_API_KEY=sk-ant-xxx

# ============================================
# OpenAI (sólo para embeddings RAG)
# ============================================
OPENAI_API_KEY=sk-xxx

# ============================================
# Tusfacturas (Facturación electrónica AFIP)
# ============================================
TUSFACTURAS_API_KEY=your-api-key
TUSFACTURAS_API_TOKEN=your-api-token
TUSFACTURAS_USER_TOKEN=your-user-token
# Modo: 'sandbox' o 'production'
TUSFACTURAS_MODE=sandbox

# ============================================
# Resend (email transaccional)
# ============================================
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Óptica Carballo <hola@opticacarballo.com.ar>

# ============================================
# Cookies firmadas (HMAC-SHA256)
# ============================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 chars. Secrets DISTINTOS entre cart y prescription (defensa en
# profundidad: si uno se compromete, el otro sigue válido).
CART_COOKIE_SECRET=
PRESCRIPTION_COOKIE_SECRET=

# ============================================
# Site config
# ============================================
NEXT_PUBLIC_SITE_URL=https://opticacarballo.com.ar
NEXT_PUBLIC_SITE_NAME=Óptica Carballo

# WhatsApp del negocio (formato internacional sin "+", sin espacios)
# Ejemplo: 5493780123456 (Argentina, Corrientes)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ============================================
# Analytics
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Datos del negocio (para schema.org)
# ============================================
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS_STREET=
NEXT_PUBLIC_BUSINESS_ADDRESS_LOCALITY=Virasoro
NEXT_PUBLIC_BUSINESS_ADDRESS_REGION=Corrientes
NEXT_PUBLIC_BUSINESS_ADDRESS_POSTAL=
NEXT_PUBLIC_BUSINESS_ADDRESS_COUNTRY=AR
NEXT_PUBLIC_BUSINESS_GEO_LAT=
NEXT_PUBLIC_BUSINESS_GEO_LON=

# Matrículas profesionales (para E-E-A-T)
NEXT_PUBLIC_REGENTE_NAME=María Carlota Carballo
NEXT_PUBLIC_REGENTE_MATRICULA=
NEXT_PUBLIC_TECNICO_NAME=Juan Carballo
NEXT_PUBLIC_TECNICO_MATRICULA=

# ============================================
# Featureflags (V1: hardcoded)
# ============================================
# Habilita el lector de receta IA
NEXT_PUBLIC_FEATURE_PRESCRIPTION_READER=true
# Habilita el asistente conversacional
NEXT_PUBLIC_FEATURE_AI_CHAT=true
# Habilita el recomendador por forma de rostro
NEXT_PUBLIC_FEATURE_FACE_RECOMMENDER=false
# Habilita el blog/guías
NEXT_PUBLIC_FEATURE_BLOG=true

# ============================================
# Notas
# ============================================
# - Las variables que empiezan con NEXT_PUBLIC_ se exponen al cliente (browser).
# - Las demás SOLO viven en el servidor. Cuidar de no usarlas en componentes 'use client'.
# - Para Vercel: estas variables se cargan en Settings > Environment Variables.
# - Distinguir Production / Preview / Development cuando agregás en Vercel.
